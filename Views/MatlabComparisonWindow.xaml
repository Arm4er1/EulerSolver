<Window x:Class="EulerSolver.Views.MatlabComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EulerSolver.Controls"
        Title="Сравнение с MATLAB"
        Width="1100" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="GroupPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Итоги -->
            <RowDefinition Height="200"/>
            <!-- Таблица — фиксированная высота -->
            <RowDefinition Height="*"/>
            <!-- График — всё остальное место -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1976D2" CornerRadius="6"
                Padding="16,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="titleText"
                           Text="Сравнение с MATLAB (ode45)"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="subtitleText"
                           Text=""
                           FontSize="12" Foreground="#BBDEFB"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="1" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Наш метод -->
                <Border Grid.Column="0" Background="#E3F2FD"
                        CornerRadius="4" Padding="12"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Модифицированный Эйлер"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1565C0"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="eulerInfoText"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555"/>
                        <TextBlock Text="Порядок точности: O(h²)"
                                   FontSize="11" Foreground="#888"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- MATLAB -->
                <Border Grid.Column="1" Background="#FFF3E0"
                        CornerRadius="4" Padding="12"
                        Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="MATLAB ode45"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E65100"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="matlabInfoText"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555"/>
                        <TextBlock Text="Метод Рунге-Кутта 4-5 порядка"
                                   FontSize="11" Foreground="#888"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Вывод -->
                <Border Grid.Column="2" Background="#E8F5E9"
                        CornerRadius="4" Padding="12"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Вывод"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="conclusionText"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Легенда -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource HeaderLabel}"
                               Text="📋 Таблица сравнения"
                               Margin="0,0,16,0"/>
                    <Ellipse Width="12" Height="12" Fill="#1E88E5"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Модифицированный Эйлер"
                               FontSize="12" Foreground="#555"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="12" Height="12" Fill="#FF7043"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="MATLAB (ode45)"
                               FontSize="12" Foreground="#555"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          x:Name="comparisonGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#FAFAFA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="1" BorderBrush="#DDD"
                          FontSize="12" FontFamily="Consolas"
                          SelectionMode="Single"
                          AlternationCount="2">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="X"
                            Binding="{Binding XFormatted}"
                            Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECEFF1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Y (Мод. Эйлер)"
                            Binding="{Binding YEulerFormatted}"
                            Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Y (MATLAB ode45)"
                            Binding="{Binding YMatlabFormatted}"
                            Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="|Разница|"
                            Binding="{Binding DifferenceFormatted}"
                            Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3E5F5"/>
                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- График — занимает всё оставшееся место -->
        <Border Grid.Row="3" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource HeaderLabel}"
                           Text="📈 График сравнения"/>

                <!-- Легенда графика -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <Ellipse Width="12" Height="12" Fill="#1E88E5"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Модифицированный Эйлер"
                               FontSize="12" Foreground="#555"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="12" Height="12" Fill="#FF7043"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="MATLAB (ode45)"
                               FontSize="12" Foreground="#555"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- График на всё оставшееся место -->
                <controls:Graph3DControl Grid.Row="2"
                                         x:Name="comparisonGraph"
                                         MinHeight="300"/>
            </Grid>
        </Border>
    </Grid>
</Window>