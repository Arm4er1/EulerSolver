<Window x:Class="EulerSolver.Views.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EulerSolver.Controls"
        Title="График решения ОДУ"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1976D2" CornerRadius="6" Padding="16,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="titleText"
                           Text="График решения"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="subtitleText"
                           Text=""
                           FontSize="12" Foreground="#BBDEFB" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- График на весь экран -->
        <Border Grid.Row="1" Background="White" CornerRadius="6"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <controls:Graph3DControl x:Name="graphControl"/>
        </Border>
    </Grid>
</Window>