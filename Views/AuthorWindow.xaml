<Window x:Class="EulerSolver.Views.AuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Об авторе"
        Width="450" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1976D2" CornerRadius="8" Padding="20,16">
            <TextBlock Text="Об авторе"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Содержимое — заглушка -->
        <Border Grid.Row="2" Background="White" CornerRadius="6"
                BorderBrush="#E0E0E0" BorderThickness="1" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="👤 Информация об авторе"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#1976D2" Margin="0,0,0,12"/>

                <!-- ЗАГЛУШКА -->
                <TextBlock Text="Будет добавлено позже."
                           FontSize="12" Foreground="#888"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Кнопка -->
        <Button Grid.Row="4"
                Content="Закрыть"
                Width="100" HorizontalAlignment="Right"
                Height="32" FontSize="13"
                Background="#1976D2" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="CloseButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>