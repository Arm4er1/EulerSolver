<Window x:Class="EulerSolver.Views.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EulerSolver.Controls"
        Title="Сравнение методов Эйлера"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="GroupPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Итоги -->
            <RowDefinition Height="Auto"/>
            <!-- Подсказка (без точного решения) -->
            <RowDefinition Height="200"/>
            <!-- Таблица -->
            <RowDefinition Height="*"/>
            <!-- График -->
        </Grid.RowDefinitions>

        <!-- ======= ЗАГОЛОВОК ======= -->
        <Border Grid.Row="0" Background="#1976D2" CornerRadius="6"
                Padding="16,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="titleText"
                           Text="Сравнение методов Эйлера"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="subtitleText"
                           Text=""
                           FontSize="12" Foreground="#BBDEFB" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ======= ИТОГИ ======= -->
        <Border Grid.Row="1" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Обычный Эйлер -->
                <Border Grid.Column="0" Background="#FFEBEE" CornerRadius="4"
                        Padding="10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Обычный Эйлер"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C62828" Margin="0,0,0,4"/>
                        <TextBlock x:Name="eulerErrorText"
                                   Text="Макс. погрешность: —"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555"/>
                        <TextBlock Text="Порядок точности: O(h)"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- Модифицированный -->
                <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="4"
                        Padding="10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Модифицированный Эйлер"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1565C0" Margin="0,0,0,4"/>
                        <TextBlock x:Name="modifiedErrorText"
                                   Text="Макс. погрешность: —"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555"/>
                        <TextBlock Text="Порядок точности: O(h²)"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- Вывод -->
                <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="4"
                        Padding="10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Вывод"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2E7D32" Margin="0,0,0,4"/>
                        <TextBlock x:Name="conclusionText"
                                   Text="—"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======= ПОДСКАЗКА (видна только когда нет точного решения) ======= -->
        <Border Grid.Row="2"
                x:Name="noExactHintBorder"
                Background="#FFF8E1"
                BorderBrush="#FFE082"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5D4037"
                           VerticalAlignment="Center">
                    <Run FontWeight="SemiBold">Точное решение не задано.</Run>
                    <Run>Колонки погрешностей скрыты. Столбец</Run>
                    <Run FontWeight="SemiBold">|Δ| между методами</Run>
                    <Run>показывает разницу двух численных методов —</Run>
                    <Run>чем она меньше, тем точнее оба метода (оценка по Рунге).</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ======= ТАБЛИЦА ======= -->
        <Border Grid.Row="3" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource HeaderLabel}"
                           Text="📋 Таблица сравнения"/>

                <DataGrid Grid.Row="1"
                          x:Name="comparisonGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#FAFAFA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="1" BorderBrush="#DDD"
                          FontSize="12" FontFamily="Consolas"
                          SelectionMode="Single"
                          AlternationCount="2">

                    <DataGrid.Columns>

                        <!-- X -->
                        <DataGridTextColumn Header="X"
                            Binding="{Binding XFormatted}" Width="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Обычный Эйлер — красный -->
                        <DataGridTextColumn Header="Y (Эйлер)"
                            Binding="{Binding YEulerFormatted}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Погрешность Эйлера — скрывается если нет точного -->
                        <DataGridTextColumn x:Name="colErrorEuler"
                            Header="Погр. Эйлер"
                            Binding="{Binding ErrorEulerFormatted}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Модифицированный — синий -->
                        <DataGridTextColumn Header="Y (Модиф.)"
                            Binding="{Binding YModifiedFormatted}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Погрешность модифицированного — скрывается если нет точного -->
                        <DataGridTextColumn x:Name="colErrorModified"
                            Header="Погр. Модиф."
                            Binding="{Binding ErrorModifiedFormatted}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Точное решение — скрывается если нет точного -->
                        <DataGridTextColumn x:Name="colExact"
                            Header="Y (точное)"
                            Binding="{Binding YExactFormatted}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- Разница между методами — всегда видна -->
                        <DataGridTextColumn x:Name="colDifference"
                            Header="|Δ| между методами"
                            Binding="{Binding DifferenceFormatted}" Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3E5F5"/>
                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ======= ГРАФИК ======= -->
        <Border Grid.Row="4" Style="{StaticResource GroupPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource HeaderLabel}"
                           Text="📈 График сравнения методов"/>

                <!-- Легенда -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse Width="12" Height="12" Fill="#E53935"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Обычный Эйлер" FontSize="12"
                               Foreground="#555" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>

                    <Ellipse Width="12" Height="12" Fill="#1E88E5"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Модифицированный Эйлер" FontSize="12"
                               Foreground="#555" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>

                    <!-- Точное решение в легенде — скрывается если нет -->
                    <StackPanel x:Name="exactLegendPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Ellipse Width="12" Height="12" Fill="#43A047"
                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Точное решение" FontSize="12"
                                   Foreground="#555" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <controls:Graph3DControl Grid.Row="2" x:Name="comparisonGraph"/>
            </Grid>
        </Border>
    </Grid>
</Window>