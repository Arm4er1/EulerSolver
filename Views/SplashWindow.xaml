<Window x:Class="EulerSolver.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EulerSolver"
        Width="750" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="BottomButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешняя тень -->
    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: шапка -->
                <RowDefinition Height="*"/>
                <!-- Row 1: центр -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Минск — 2026 -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: таймер -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: нижняя полоса -->
            </Grid.RowDefinitions>

            <!-- ======= ШАПКА ======= -->
            <Border Grid.Row="0" Background="#1976D2"
                    CornerRadius="10,10,0,0" Padding="28,22,28,18">
                <StackPanel>
                    <TextBlock Text="КУРСОВОЙ ПРОЕКТ"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#BBDEFB"
                               TextAlignment="Center"/>

                    <TextBlock Text="по дисциплине"
                               FontSize="12" Foreground="#90CAF9"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="«Разработка приложений в визуальных средах»"
                               FontSize="13" Foreground="White"
                               FontStyle="Italic"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Решение ОДУ модифицированным методом Эйлера"
                               FontSize="17" FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======= ЦЕНТР ======= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: картинка -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="28,16,10,16">

                    <Border Width="260" Height="160"
                            CornerRadius="8"
                            Background="#E3F2FD"
                            BorderBrush="#90CAF9"
                            BorderThickness="1.5">
                        <Grid>
                            <Canvas Width="260" Height="160"
                                    ClipToBounds="True">

                                <!-- Оси -->
                                <Line X1="20" Y1="140" X2="250" Y2="140"
                                      Stroke="#90CAF9" StrokeThickness="1.5"/>
                                <Line X1="20" Y1="10" X2="20" Y2="145"
                                      Stroke="#90CAF9" StrokeThickness="1.5"/>

                                <!-- Стрелки осей -->
                                <Polygon Points="250,136 258,140 250,144"
                                         Fill="#90CAF9"/>
                                <Polygon Points="16,10 20,2 24,10"
                                         Fill="#90CAF9"/>

                                <!-- Подписи осей -->
                                <TextBlock Canvas.Left="252" Canvas.Top="133"
                                           Text="x" FontSize="11"
                                           Foreground="#1976D2"/>
                                <TextBlock Canvas.Left="24" Canvas.Top="2"
                                           Text="y" FontSize="11"
                                           Foreground="#1976D2"/>

                                <!-- Кривая -->
                                <Polyline StrokeThickness="2.5"
                                          Stroke="#1E88E5"
                                          StrokeLineJoin="Round"
                                          Points="20,135 45,128 70,118
                                                  95,104 120,86 145,64
                                                  170,40 195,22 210,14"/>

                                <!-- Точки метода Эйлера -->
                                <Ellipse Canvas.Left="43" Canvas.Top="125"
                                         Width="5" Height="5" Fill="#E53935"/>
                                <Ellipse Canvas.Left="93" Canvas.Top="100"
                                         Width="5" Height="5" Fill="#E53935"/>
                                <Ellipse Canvas.Left="143" Canvas.Top="60"
                                         Width="5" Height="5" Fill="#E53935"/>
                                <Ellipse Canvas.Left="193" Canvas.Top="18"
                                         Width="5" Height="5" Fill="#E53935"/>

                                <!-- Легенда -->
                                <Line X1="30" Y1="18" X2="52" Y2="18"
                                      Stroke="#1E88E5" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="55" Canvas.Top="11"
                                           Text="y(x)" FontSize="10"
                                           Foreground="#1E88E5"/>
                                <Ellipse Canvas.Left="30" Canvas.Top="28"
                                         Width="7" Height="7" Fill="#E53935"/>
                                <TextBlock Canvas.Left="42" Canvas.Top="25"
                                           Text="y' = f(x,y)" FontSize="10"
                                           Foreground="#E53935"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Правая часть: исполнители -->
                <Border Grid.Column="1"
                        Background="#F5F9FF"
                        BorderBrush="#BBDEFB"
                        BorderThickness="1,0,0,0"
                        Padding="20,16,24,16"
                        VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Выполнил:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1565C0"/>
                        <TextBlock Text="студент группы 10701324"
                                   FontSize="12" Foreground="#444"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="Никитин Денис Алексеевич"
                                   FontSize="12" Foreground="#222"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>

                        <Separator Margin="0,14,0,14" Background="#BBDEFB"/>

                        <TextBlock Text="Преподаватель:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1565C0"/>
                        <TextBlock Text="кандидат технических наук,"
                                   FontSize="12" Foreground="#444"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="доцент"
                                   FontSize="12" Foreground="#444"/>
                        <TextBlock Text="Гурский Николай Николаевич"
                                   FontSize="12" Foreground="#222"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======= МИНСК — 2026 (Row 2, по центру) ======= -->
            <TextBlock Grid.Row="2"
                       Text="Минск — 2026"
                       FontSize="13"
                       Foreground="#777"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,8,0,8"/>

            <!-- ======= ТАЙМЕР (Row 3) ======= -->
            <Border Grid.Row="3" Background="#FAFAFA"
                    Padding="0,4,0,6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="timerText"
                               Text="Автозакрытие через 60 сек."
                               FontSize="11" Foreground="#BDBDBD"
                               TextAlignment="Center"/>
                    <ProgressBar x:Name="timerBar"
                                 Width="340" Height="4"
                                 Minimum="0" Maximum="60"
                                 Value="60"
                                 Foreground="#90CAF9"
                                 Background="#E3F2FD"
                                 BorderThickness="0"
                                 Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======= НИЖНЯЯ ПОЛОСА (Row 4) ======= -->
            <Border Grid.Row="4" Background="#1976D2"
                    CornerRadius="0,0,10,10" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="v1.0  ·  Модифицированный метод Эйлера"
                               FontSize="11" Foreground="#90CAF9"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnExit"
                                Content="Выход"
                                Style="{StaticResource BottomButton}"
                                Background="#EF5350"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="BtnExit_Click"/>

                        <Button x:Name="btnStart"
                                Content="Далее  ▶"
                                Style="{StaticResource BottomButton}"
                                Background="White"
                                Foreground="#1976D2"
                                Click="BtnStart_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>