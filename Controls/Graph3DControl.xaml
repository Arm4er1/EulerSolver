<UserControl x:Class="EulerSolver.Controls.Graph3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖱 ЛКМ — вращение  |  Колёсико — масштаб  |  ПКМ — сброс"
                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Контейнер для 3D + overlay подписей -->
        <Grid Grid.Row="1"
              MouseLeftButtonDown="OnMouseLeftDown"
              MouseLeftButtonUp="OnMouseLeftUp"
              MouseMove="OnMouseMove"
              MouseWheel="OnMouseWheel"
              MouseRightButtonDown="OnResetView"
              Background="Transparent">

            <!-- 3D сцена -->
            <Viewport3D x:Name="viewport" ClipToBounds="True">

                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="camera"
                                       Position="5,5,5"
                                       LookDirection="-1,-1,-1"
                                       UpDirection="0,1,0"
                                       FieldOfView="60"/>
                </Viewport3D.Camera>

                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#404040"/>
                            <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-2"/>
                            <DirectionalLight Color="#808080" Direction="1,0.5,1"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <ModelVisual3D x:Name="graphContent"/>
            </Viewport3D>

            <!-- Canvas для 2D подписей поверх 3D -->
            <Canvas x:Name="overlayCanvas" IsHitTestVisible="False"/>

            <!-- Tooltip при наведении на точку -->
            <Border x:Name="tooltipBorder"
                    Background="#EE333333" CornerRadius="4"
                    Padding="8,4" Visibility="Collapsed"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="tooltipText"
                           Foreground="White" FontSize="12"
                           FontFamily="Consolas"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>